rules_version = '2';

// =============================================================================
// WanderSync Firestore security rules
// =============================================================================
// Replaces the Firebase Console's default "test mode" rule (open read/write to
// everyone, expiring on a fixed date) with: no expiry, require
// request.auth != null (anonymous sign-in, see index.html's checkAuthAndProceed),
// and allow fetching a single trip by exact ID while blocking listing/enumeration
// of the collection.
//
// This does NOT make trip IDs (user-chosen "sync codes") unguessable, nor does it
// let these rules enforce the client-side PIN check. See RUNBOOK.zh.md for the
// full security-model write-up (why, what's still exposed, and what a real fix
// would require) — kept out of this file so the actual rules aren't buried under
// the essay explaining them.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Path 1: BYOD mode (user pasted their own Firebase config).
    // See index.html's window.getTripDocRef, isBYOD === true branch:
    //   doc(db, 'travel_plans', id)
    match /travel_plans/{tripId} {

      // Split get/list rather than `allow read`: `read` is shorthand for both,
      // and allowing `list` would let any signed-in user enumerate the whole
      // collection instead of only fetching a trip they already have the ID
      // for — a much bigger exposure than a single guessable ID.
      allow get: if request.auth != null;
      allow list: if false;

      // Whole-document overwrite, matching saveToCloud()'s setDoc() call.
      // Cannot validate the PIN here — it's a client-side-only field. See
      // RUNBOOK.zh.md.
      allow write: if request.auth != null;

      // Rules do not inherit into subcollections, so `images` needs its own
      // block or it silently falls back to default-deny (images fail to
      // load/save while the trip itself works fine — easy to misdiagnose as
      // a frontend bug). Same get/list split as above; the app never lists
      // this collection, only reads/writes by exact imageId.
      match /images/{imageId} {
        allow get: if request.auth != null;
        allow list: if false;
        allow write: if request.auth != null;
      }
    }

    // Path 2: sandboxed hosting mode (default when no Firebase config is
    // supplied). See index.html's window.getTripDocRef, isBYOD === false branch:
    //   doc(db, 'artifacts', appId, 'public', 'data', 'travel_plans', id)
    // {appId} is a wildcard: it's not a secret (the client can always read its
    // own __app_id), so the real boundary is still the get/list split below.
    match /artifacts/{appId}/public/data/travel_plans/{tripId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if request.auth != null;

      match /images/{imageId} {
        allow get: if request.auth != null;
        allow list: if false;
        allow write: if request.auth != null;
      }
    }

    // No catch-all here on purpose. Firestore already default-denies anything
    // not explicitly allowed, and rules OR together — an `allow ...: if false`
    // catch-all at /{document=**} wouldn't (and couldn't) revoke the get/write
    // already granted above; it would only look like extra protection while
    // enforcing nothing.
  }
}
