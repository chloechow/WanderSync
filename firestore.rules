rules_version = '2';

// =============================================================================
// WanderSync Firestore 安全规则
// =============================================================================
//
// 【背景】
// Firebase 控制台里当前生效的规则是「测试模式」默认值：
//
//   match /{document=**} {
//     allow read, write: if request.time < timestamp.date(2026, 10, 30);
//   }
//
// 这条规则有两个严重问题：
//   1. 定时炸弹：2026-10-30 之后所有读写请求会被拒绝，整个 App 直接打不开。
//   2. 更严重的是在这之前——它允许互联网上任何人，不需要任何登录/鉴权，
//      读取、修改、删除数据库里的任何数据。任何知道项目 API Key（在前端
//      代码里，本来就是公开的）的人都可以用浏览器控制台或者一行 curl
//      把全部用户的行程数据拉走或者清空。
//
// 本文件替换掉这条规则，改为：
//   - 去掉时间炸弹，不再有到期日
//   - 要求 request.auth != null（App 用 signInAnonymously() 做匿名登录，
//     见 index.html 里 checkAuthAndProceed() 附近的调用）
//   - 只放行「拿着完整行程 ID 读单个文档」（get），明确禁止「列出整个
//     collection」（list）——这是本文件里最关键的一条，详见下方说明。
//
// 【这份规则「没有」解决的问题——请务必读完】
// WanderSync 用一个用户自己起的、未加密的短字符串当「同步码」当行程 ID
// （例如 "SEOUL2026"），本质上是没有随机性的：
//   - index.html:364  attemptLogin()  里：
//       idInput = document.getElementById('login-id').value.trim().toUpperCase()
//   - index.html:1085 语音/表单同步逻辑里同样是：
//       newId = v.sid.trim().toUpperCase()
//   两处都只是「去空格 + 转大写」，没有任何随机生成、没有长度下限、
//   也不检查是否已被占用。也就是说同步码是完全由用户自己选、大概率是
//   "SEOUL2026" "TOKYO2027" 这类可猜测的地名+年份组合的字符串。
//
// 本文件里的 `allow get: if request.auth != null;` 意味着：
//   任何人只要（匿名）登录一次、并且**猜中或恰好拿到**某个行程的同步码，
//   就可以把那个行程的完整数据读走。Firestore 规则天生无法阻止「暴力
//   枚举/猜测文档 ID」这件事——ID 本身不是秘密，规则引擎也看不到
//   「这个人是不是尝试了 1000 个不同的 ID」。
//
// 更进一步：App 里的「访问密码」（PIN）*也*保护不了这件事。见
// index.html:519 startSync() 的逻辑——客户端是先用 onSnapshot 把整份
// 云端文档订阅/读取下来，*然后*才在 JS 里比较 `cloudData.pin !== reqPin`。
// 也就是说，即便攻击者不知道 PIN、界面上会显示「访问密码错误」，
// 完整的行程数据在这之前已经从 Firestore 传到了攻击者手里——PIN
// 检查只发生在数据到达之后的客户端，Firestore 规则完全看不到 PIN
// 这个字段，也无法拿它做访问控制。
//
// 结论：这份规则把「谁都不用登录就能读写一切」收紧成了「登录后，
// 知道/猜中同步码就能读单个行程」。这是本轮修复能做到、且不引入
// 额外开发成本的最大改进。要彻底解决「同步码可猜测」的问题，
// 需要修改 App 本身（例如：创建行程时随机生成、足够长、不可预测的
// 同步码，或者引入真正的账号体系 + 服务器端校验 PIN），这明确超出
// 本轮修复范围，留给后续迭代。
//
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // 路径一：BYOD 模式（用户在设置里粘贴了自己的 Firebase 配置）
    // 对应 index.html:311 window.getTripDocRef 中 isBYOD === true 分支：
    //   doc(db, 'travel_plans', id)
    // -------------------------------------------------------------------
    match /travel_plans/{tripId} {

      // 【最关键的一条规则】只允许按精确 ID 的单文档读取（get），
      // 明确禁止列出/遍历整个 collection（list）。
      //
      // 为什么不能偷懒写成 `allow read: if request.auth != null;`？
      // 因为在 Firestore 规则语言里，`read` 只是 `get` 和 `list` 两种
      // 权限的合并简写（等价于同时写了 allow get 和 allow list）。
      // 如果这里写 allow read，效果是：任何一个完成了匿名登录的用户，
      // 都可以对 travel_plans 发起 `.get()` 查询（不带任何 where 条件，
      // 或者用极宽松的条件），一次性把*全世界所有用户*的行程数据
      // 全部拉下来——这比「能猜中一个 ID 读一份」严重得多，等于
      // 完全没有收紧。拆成 get + list 并把 list 显式设为 false，
      // 是把「按 ID 读单份」和「批量列出」这两种完全不同风险级别
      // 的操作分开处理，只放行前者。
      allow get: if request.auth != null;
      allow list: if false;

      // 允许已登录用户整份写入/覆盖/删除单个文档，与现有代码的写入
      // 方式一致——见 index.html:325 saveToCloud() 里的
      // `setDoc(window.getTripDocRef(tripId), tripData)`，整个行程
      // 是一份文档，每次整体覆盖，没有字段级别的增量更新。
      // 注：这里同样无法也没有尝试校验 PIN 是否正确——原因见文件顶部
      // 的说明，PIN 只存在于客户端逻辑里，Firestore 规则拿不到、
      // 也不应该指望靠它做写入保护。
      allow write: if request.auth != null;
    }

    // -------------------------------------------------------------------
    // 路径二：沙箱托管模式（未自带 Firebase 配置时的默认路径）
    // 对应 index.html:311 window.getTripDocRef 中 isBYOD === false 分支：
    //   doc(db, 'artifacts', appId, 'public', 'data', 'travel_plans', id)
    // {appId} 对应运行时注入的 __app_id（见 index.html window.getAppId）。
    // 这里用通配符承接、不做取值限制：appId 本身不是秘密（客户端
    // 一直都能读到自己的 __app_id 并据此拼出这段路径），在这一层
    // 限制 appId 的取值并不能提供额外的安全性，真正的边界仍然是
    // 下面这条 get/list 规则。
    // -------------------------------------------------------------------
    match /artifacts/{appId}/public/data/travel_plans/{tripId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if request.auth != null;
    }

    // -------------------------------------------------------------------
    // 其余所有路径：这里没有写任何规则。
    //
    // Firestore 的规则引擎默认拒绝一切未被显式 allow 的读写，所以
    // 「什么都不写」本身就是安全的默认行为（default-deny），不需要
    // 额外的兜底规则。
    //
    // 特别提醒：不要为了「看起来更保险」而在这里加一条
    //   match /{document=**} { allow read, write: if false; }
    // Firestore 对同一个请求匹配到的多条 allow 语句是「或」
    // （OR）的关系——只要*任意一条*匹配的规则允许，请求就会被允许。
    // 一条写在最外层、条件恒为 false 的兜底规则，既不会、也不能
    // 收回上面 travel_plans / artifacts/.../travel_plans 两个 match
    // 块里已经放行的 get/write 权限（那两块本来就没有被这条 catch-all
    // 影响），它唯一的作用是给后来读规则的人一个错觉——以为这是
    // 在「加强」限制，但实际上什么限制也没加，反而可能掩盖了
    // 「真正生效的收紧其实是上面两个具体 match 块」这个事实。
    // 所以这里刻意不写这类装饰性规则，只用这段注释说明现状。
    // -------------------------------------------------------------------
  }
}
